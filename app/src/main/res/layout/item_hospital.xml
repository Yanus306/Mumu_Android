<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_community_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
    <ImageView android:id="@+id/iv_hospital" android:layout_width="76dp" android:layout_height="76dp" android:background="@color/mumugray_50" android:contentDescription="병원 사진" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_hospital_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_semibold" android:textColor="@color/mumugray_400" android:textSize="16sp" />
        <TextView android:id="@+id/tv_hospital_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/mumugray_350" android:textSize="12sp" />
        <TextView android:id="@+id/tv_hospital_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/mumu_300" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingHorizontal="20dp">

    <TextView android:id="@+id/tv_hospital_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="@font/pretendard_semibold" android:text="동물병원 찾기" android:textColor="@color/mumugray_400" android:textSize="22sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tv_hospital_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="서울 중심 20km 기준" android:textColor="@color/mumugray_350" android:textSize="12sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_hospital_title" />
    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/et_hospital_search" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="18dp" android:background="@drawable/bg_community_input" android:hint="병원 이름 검색" android:imeOptions="actionSearch" android:paddingHorizontal="16dp" android:singleLine="true" app:layout_constraintEnd_toStartOf="@id/btn_hospital_search" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_hospital_location" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_hospital_search" android:layout_width="72dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_analysis_primary" android:text="검색" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@null" app:layout_constraintBottom_toBottomOf="@id/et_hospital_search" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/et_hospital_search" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_hospitals" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="16dp" android:clipToPadding="false" android:paddingBottom="12dp" app:layout_constraintBottom_toTopOf="@id/btn_more_hospitals" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/et_hospital_search" />
    <TextView android:id="@+id/tv_hospital_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/mumugray_350" android:textSize="14sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/rv_hospitals" app:layout_constraintEnd_toEndOf="@id/rv_hospitals" app:layout_constraintStart_toStartOf="@id/rv_hospitals" app:layout_constraintTop_toTopOf="@id/rv_hospitals" />
    <ProgressBar android:id="@+id/progress_hospitals" android:layout_width="40dp" android:layout_height="40dp" app:layout_constraintBottom_toBottomOf="@id/rv_hospitals" app:layout_constraintEnd_toEndOf="@id/rv_hospitals" app:layout_constraintStart_toStartOf="@id/rv_hospitals" app:layout_constraintTop_toTopOf="@id/rv_hospitals" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_more_hospitals" android:layout_width="0dp" android:layout_height="44dp" android:background="@drawable/bg_community_action" android:text="더 보기" android:textAllCaps="false" android:visibility="gone" app:backgroundTint="@null" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

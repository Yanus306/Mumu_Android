<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.my.MyInformationAdministerActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_mumu_logo"
            android:layout_width="36dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/mumu_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_topbar"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="Mumu"
            android:textColor="@color/mumuyellow_300"
            android:textSize="@dimen/title"
            app:layout_constraintStart_toEndOf="@id/iv_mumu_logo"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/bg_yellow100_solid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_topbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_picture_information"
            android:layout_width="117dp"
            android:layout_height="117dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_picture_information"
                android:layout_width="109dp"
                android:layout_height="109dp"
                app:cardCornerRadius="55dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/mumuyellow_300"
                    android:scaleType="center"
                    android:src="@drawable/ic_camera" />

            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/layout_picture_information">

            <TextView
                android:id="@+id/tv_name_administer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_start_line"
                android:paddingStart="5dp"
                android:text="이름"
                android:textColor="@color/mumugray_350"
                android:textSize="@dimen/body_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_name_administer"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:background="@drawable/bg_gray200_stroke"
                android:paddingStart="12dp"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_5"
                app:layout_constraintTop_toBottomOf="@id/tv_name_administer" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_eidt"
                app:layout_constraintBottom_toBottomOf="@id/et_name_administer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/et_name_administer" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@id/layout_id"
            app:layout_constraintStart_toStartOf="@id/layout_id"
            app:layout_constraintTop_toBottomOf="@id/layout_id">

            <TextView
                android:id="@+id/tv_gender"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_start_line"
                android:paddingStart="5dp"
                android:text="성별"
                android:textColor="@color/mumugray_350"
                android:textSize="@dimen/body_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_gender"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:background="@drawable/bg_gray200_stroke"
                android:paddingStart="12dp"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_5"
                app:layout_constraintTop_toBottomOf="@id/tv_gender" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_eidt"
                app:layout_constraintBottom_toBottomOf="@id/et_gender"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/et_gender" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_phoneNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@id/layout_id"
            app:layout_constraintStart_toStartOf="@id/layout_id"
            app:layout_constraintTop_toBottomOf="@id/layout_name">

            <TextView
                android:id="@+id/tv_phoneNumber"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_start_line"
                android:paddingStart="5dp"
                android:text="나이"
                android:textColor="@color/mumugray_350"
                android:textSize="@dimen/body_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_phoneNumber"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:background="@drawable/bg_gray200_stroke"
                android:paddingStart="12dp"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_5"
                app:layout_constraintTop_toBottomOf="@id/tv_phoneNumber" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_eidt"
                app:layout_constraintBottom_toBottomOf="@id/et_phoneNumber"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/et_phoneNumber" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@id/layout_id"
            app:layout_constraintStart_toStartOf="@id/layout_id"
            app:layout_constraintTop_toBottomOf="@id/layout_phoneNumber">

            <TextView
                android:id="@+id/tv_address"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_start_line"
                android:paddingStart="5dp"
                android:text="종류"
                android:textColor="@color/mumugray_350"
                android:textSize="@dimen/body_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_address"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:background="@drawable/bg_gray200_stroke"
                android:paddingStart="12dp"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_5"
                app:layout_constraintTop_toBottomOf="@id/tv_address" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_eidt"
                app:layout_constraintBottom_toBottomOf="@id/et_address"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/et_address" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_marginTop="113dp"
            android:background="@drawable/bg_yellow300_solid"
            android:gravity="center"
            android:text="저장하기"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/body_5"
            app:layout_constraintEnd_toEndOf="@id/layout_id"
            app:layout_constraintStart_toStartOf="@id/layout_id"
            app:layout_constraintTop_toBottomOf="@id/layout_address" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_change_profile"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_gray350_stroke"
            android:gravity="center"
            android:text="프로필 교체"
            android:textColor="@color/mumugray_350"
            android:textSize="@dimen/body_5"
            app:layout_constraintEnd_toEndOf="@id/layout_id"
            app:layout_constraintStart_toStartOf="@id/layout_id"
            app:layout_constraintTop_toBottomOf="@id/btn_save" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
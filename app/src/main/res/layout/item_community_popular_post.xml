<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/pretendard_regular"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/mumugray_400"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/iv_heart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="게시글 제목" />

    <ImageView
        android:id="@+id/iv_heart"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="좋아요"
        android:src="@drawable/ic_community_heart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_like_count"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:fontFamily="@font/pretendard_regular"
        android:gravity="center"
        android:textColor="@color/mumugray_150"
        android:textSize="8sp"
        app:layout_constraintEnd_toEndOf="@id/iv_heart"
        app:layout_constraintTop_toBottomOf="@id/iv_heart"
        tools:text="60" />

</androidx.constraintlayout.widget.ConstraintLayout>

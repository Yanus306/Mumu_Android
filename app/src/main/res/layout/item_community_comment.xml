<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tv_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_community_avatar"
        android:fontFamily="@font/pretendard_semibold"
        android:gravity="center"
        android:text="M"
        android:textColor="@color/mumu_300"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:fontFamily="@font/pretendard_semibold"
        android:textColor="@color/mumugray_400"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/layout_comment_manage"
        app:layout_constraintStart_toEndOf="@id/tv_avatar"
        app:layout_constraintTop_toTopOf="@id/tv_avatar"
        tools:text="사용자 2" />

    <LinearLayout
        android:id="@+id/layout_comment_manage"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_edit_comment"
            android:layout_width="42dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/pretendard_medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="수정"
            android:textAllCaps="false"
            android:textColor="@color/mumugray_300"
            android:textSize="10sp"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_delete_comment"
            android:layout_width="42dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/pretendard_medium"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="삭제"
            android:textAllCaps="false"
            android:textColor="@color/mumured"
            android:textSize="10sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/pretendard_regular"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/mumugray_400"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_avatar"
        app:layout_constraintTop_toBottomOf="@id/tv_author"
        tools:text="정말 귀여워요! 다음 산책 이야기도 기대할게요." />

    <TextView
        android:id="@+id/tv_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="@color/mumugray_200"
        android:textSize="10sp"
        app:layout_constraintStart_toEndOf="@id/tv_avatar"
        app:layout_constraintTop_toBottomOf="@id/tv_content"
        tools:text="2026.08.27 · 좋아요 2" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/mumugray_100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_author"
        app:layout_constraintTop_toBottomOf="@id/tv_meta" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:id="@+id/layout_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_previous_month" android:layout_width="36dp" android:layout_height="36dp"
                android:background="@android:color/transparent" android:contentDescription="이전 달" android:minWidth="0dp" android:minHeight="0dp"
                android:text="‹" android:textAllCaps="false" android:textColor="@color/mumugray_400" android:textSize="20sp" app:backgroundTint="@null" />
            <TextView
                android:id="@+id/tv_calendar_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold" android:gravity="center" android:minWidth="108dp"
                android:textColor="@color/mumugray_400" android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_next_month" android:layout_width="36dp" android:layout_height="36dp"
                android:background="@android:color/transparent" android:contentDescription="다음 달" android:minWidth="0dp" android:minHeight="0dp"
                android:text="›" android:textAllCaps="false" android:textColor="@color/mumugray_400" android:textSize="20sp" app:backgroundTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_calendar_days" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_calendar_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="@font/pretendard_regular" android:gravity="center"
            android:textColor="@color/mumugray_200" android:textSize="11sp" android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_diary_pet" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular" android:gravity="center" android:text="우리 아이의 하루를 기록해 주세요."
        android:textColor="@color/mumugray_350" android:textSize="12sp" android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress_diaries" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:indeterminateTint="@color/mumu_300" />

    <TextView
        android:id="@+id/tv_diary_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:fontFamily="@font/pretendard_regular" android:gravity="center"
        android:textColor="@color/mumugray_350" android:textSize="13sp" android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_diaries" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="10dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_more_diaries" android:layout_width="match_parent" android:layout_height="42dp"
        android:layout_marginBottom="8dp" android:background="@drawable/bg_community_action" android:fontFamily="@font/pretendard_medium"
        android:text="더 보기" android:textAllCaps="false" android:textColor="@color/mumugray_400" android:visibility="gone" app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_write_diary" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_semibold"
        android:text="일기"
        android:textColor="@color/mumugray_400"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tv_diary_pet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/pretendard_regular"
        android:text="우리 아이의 하루를 기록해 주세요."
        android:textColor="@color/mumugray_350"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_write_diary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_analysis_primary"
        android:text="+ 일기 쓰기"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@null" />

    <ProgressBar
        android:id="@+id/progress_diaries"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:indeterminateTint="@color/mumu_300" />

    <TextView
        android:id="@+id/tv_diary_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/mumugray_350"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_diaries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_more_diaries"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_community_action"
        android:text="더 보기"
        android:textAllCaps="false"
        android:textColor="@color/mumugray_400"
        android:visibility="gone"
        app:backgroundTint="@null" />
</LinearLayout>

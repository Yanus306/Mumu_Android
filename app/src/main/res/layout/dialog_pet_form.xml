<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_my_surface"
    android:layout_marginHorizontal="9dp"
    android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp">

        <TextView android:id="@+id/tv_form_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/iv_pet_profile" android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:layout_marginBottom="28dp" android:src="@drawable/ic_foot" android:background="@drawable/bg_community_avatar" android:scaleType="centerInside" android:contentDescription="반려동물 프로필 사진" android:clipToOutline="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="이름" android:fontFamily="@font/pretendard_regular" android:textSize="12sp" android:textColor="@color/mumugray_400" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_pet_name"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_diary_card"
            android:hint="이름 (필수)"
            android:maxLength="50"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="성별" android:fontFamily="@font/pretendard_regular" android:textSize="12sp" android:textColor="@color/mumugray_400" />
        <Spinner
            android:id="@+id/spinner_gender"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_diary_card"
            android:paddingHorizontal="12dp"
            android:fontFamily="@font/pretendard_regular" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="나이 · 생년월일" android:fontFamily="@font/pretendard_regular" android:textSize="12sp" android:textColor="@color/mumugray_400" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_birth_date"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_diary_card"
            android:focusable="false"
            android:hint="생년월일 (선택)"
            android:paddingHorizontal="12dp"
            android:fontFamily="@font/pretendard_regular" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="종류" android:fontFamily="@font/pretendard_regular" android:textSize="12sp" android:textColor="@color/mumugray_400" />
        <Spinner
            android:id="@+id/spinner_species"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_diary_card"
            android:paddingHorizontal="12dp"
            android:fontFamily="@font/pretendard_regular" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_extra_info" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:background="@android:color/transparent" android:text="추가 정보 펼치기" android:textColor="@color/mumugray_350" android:textSize="12sp" />
        <LinearLayout android:id="@+id/layout_extra_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_breed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_diary_card"
            android:hint="품종 (선택)"
            android:maxLength="100"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_weight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_diary_card"
            android:hint="몸무게 kg (선택)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:fontFamily="@font/pretendard_regular" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_neutered"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/pretendard_regular"
            android:text="중성화했어요"
            android:textColor="@color/mumugray_400" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pretendard_semibold"
            android:text="건강 정보"
            android:textColor="@color/mumu_300"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_allergies"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_diary_card"
            android:hint="알레르기 (선택)"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_chronic_diseases"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_diary_card"
            android:hint="만성질환 (선택)"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_medications"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_diary_card"
            android:hint="복용 중인 약 (선택)"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular" />

        </LinearLayout>
        <TextView
            android:id="@+id/tv_form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/mumured"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingBottom="20dp"
            android:paddingTop="8dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_pet"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_analysis_primary"
                android:fontFamily="@font/pretendard_medium"
                android:text="저장하기"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_community_action"
                android:fontFamily="@font/pretendard_medium"
                android:text="돌아가기"
                android:layout_marginTop="8dp"
                android:textAllCaps="false"
                android:textColor="@color/mumugray_400"
                app:backgroundTint="@null" />
        </LinearLayout>
</LinearLayout>

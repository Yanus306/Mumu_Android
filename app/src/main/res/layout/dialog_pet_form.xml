<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_form_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_semibold"
            android:textColor="@color/mumugray_400"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_pet_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_community_input"
            android:hint="이름 (필수)"
            android:maxLength="50"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/spinner_species"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:paddingHorizontal="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_breed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:hint="품종 (선택)"
            android:maxLength="100"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/spinner_gender"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:paddingHorizontal="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_birth_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:focusable="false"
            android:hint="생년월일 (선택)"
            android:paddingHorizontal="12dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_weight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:hint="몸무게 kg (선택)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_neutered"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="중성화했어요"
            android:textColor="@color/mumugray_400" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_allergies"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:hint="알레르기 (선택)"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_chronic_diseases"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:hint="만성질환 (선택)"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_medications"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_community_input"
            android:hint="복용 중인 약 (선택)"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/mumured"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_community_action"
                android:text="취소"
                android:textAllCaps="false"
                android:textColor="@color/mumugray_400"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_pet"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_analysis_primary"
                android:text="저장"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ProgressBar
        android:id="@+id/progress_detail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/mumu_300"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="25dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_result_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:text="분석결과: 비정상"
            android:textColor="@color/cardred"
            android:textSize="@dimen/body_1" />

        <TextView
            android:id="@+id/tv_probability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:text="72% 확률"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="584dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_analysis_panel"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:gravity="end"
                android:text="2026.04.15"
                android:textColor="@color/mumugray_300"
                android:textSize="@dimen/body_5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center"
                android:text="의심 행동"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_4" />

            <TextView
                android:id="@+id/tv_suspected_behavior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pretendard_medium"
                android:gravity="center"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_3" />

            <TextView
                android:id="@+id/tv_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_4" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:textColor="@color/mumugray_350"
            android:textSize="@dimen/body_4" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_retry"
            android:layout_width="128dp"
            android:layout_height="43dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_analysis_primary"
            android:fontFamily="@font/pretendard_medium"
            android:text="다시 시도"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/body_5"
            app:backgroundTint="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="78dp"
        android:fontFamily="@font/pretendard_semibold"
        android:text="Mumu의 이용약관에\n동의해 주세요!"
        android:textColor="@color/mumublack"
        android:textSize="@dimen/body_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="마지막 단계에요!"
        android:textColor="@color/mumugray_250"
        app:layout_constraintStart_toStartOf="@id/tv_title"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <CheckBox
            android:id="@+id/cb_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:paddingStart="12dp"
            android:text="전체 동의하기"
            android:textColor="@color/mumublack"
            android:textSize="@dimen/body_4"
            app:buttonTint="@color/mumumint_300" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/line_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/mumugray_150"
            app:layout_constraintTop_toBottomOf="@id/cb_all" />

        <CheckBox
            android:id="@+id/cb_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/pretendard_medium"
            android:paddingStart="12dp"
            android:text="이용약관 (필수) "
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4"
            app:buttonTint="@color/mumumint_300"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line_divider" />

        <TextView
            android:id="@+id/tv_terms_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="자세히 보기"
            android:textColor="@color/mumugray_250"
            android:textSize="@dimen/body_6"
            app:layout_constraintBottom_toBottomOf="@id/cb_terms"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cb_terms" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/mumugray_250"
            app:layout_constraintEnd_toEndOf="@id/tv_terms_detail"
            app:layout_constraintStart_toStartOf="@id/tv_terms_detail"
            app:layout_constraintTop_toBottomOf="@id/tv_terms_detail" />

        <CheckBox
            android:id="@+id/cb_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/pretendard_medium"
            android:paddingStart="12dp"
            android:text="개인정보 취급방침 (필수)"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4"
            app:buttonTint="@color/mumumint_300"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cb_terms" />

        <TextView
            android:id="@+id/tv_privacy_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="자세히 보기"
            android:textColor="@color/mumugray_250"
            android:textSize="@dimen/body_6"
            app:layout_constraintBottom_toBottomOf="@id/cb_privacy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cb_privacy" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/mumugray_250"
            app:layout_constraintEnd_toEndOf="@id/tv_privacy_detail"
            app:layout_constraintStart_toStartOf="@id/tv_privacy_detail"
            app:layout_constraintTop_toBottomOf="@id/tv_privacy_detail" />

        <CheckBox
            android:id="@+id/cb_marketing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/pretendard_medium"
            android:paddingStart="12dp"
            android:text="마케팅 수신 동의 (선택)"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4"
            app:buttonTint="@color/mumumint_300"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cb_privacy" />

        <TextView
            android:id="@+id/tv_marketing_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="자세히 보기"
            android:textColor="@color/mumugray_250"
            android:textSize="@dimen/body_6"
            app:layout_constraintBottom_toBottomOf="@id/cb_marketing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cb_marketing" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/mumugray_250"
            app:layout_constraintEnd_toEndOf="@id/tv_marketing_detail"
            app:layout_constraintStart_toStartOf="@id/tv_marketing_detail"
            app:layout_constraintTop_toBottomOf="@id/tv_marketing_detail" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
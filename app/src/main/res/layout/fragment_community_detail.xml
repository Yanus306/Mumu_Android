<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_community_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_community_avatar"
                        android:fontFamily="@font/pretendard_semibold"
                        android:gravity="center"
                        android:text="M"
                        android:textColor="@color/mumu_300"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_post_author"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_semibold"
                            android:textColor="@color/mumugray_400"
                            android:textSize="13sp"
                            tools:text="사용자 1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_regular"
                            android:text="반려생활 이야기"
                            android:textColor="@color/mumugray_200"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_category"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_community_chip"
                        android:fontFamily="@font/pretendard_medium"
                        android:gravity="center"
                        android:minWidth="52dp"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/mumugray_350"
                        android:textSize="10sp"
                        tools:text="자유" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/pretendard_semibold"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/mumugray_400"
                    android:textSize="20sp"
                    tools:text="오늘 산책에서 만난 작은 행복" />

                <TextView
                    android:id="@+id/tv_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:textColor="@color/mumugray_200"
                    android:textSize="10sp"
                    tools:text="2026.08.27 · 조회 12 · 댓글 3" />

                <ImageView
                    android:id="@+id/iv_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_community_input"
                    android:clipToOutline="true"
                    android:contentDescription="게시글 이미지"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:src="@drawable/dog"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:lineSpacingExtra="6dp"
                    android:minHeight="100dp"
                    android:textColor="@color/mumugray_400"
                    android:textSize="14sp"
                    tools:text="우리 아이와 함께한 오늘의 소중한 순간을 나눠요." />

                <TextView
                    android:id="@+id/tv_hashtags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/pretendard_medium"
                    android:textColor="@color/mumu_300"
                    android:textSize="12sp"
                    tools:text="#강아지 #산책 #일상" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/mumugray_100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_like"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_community_action"
                        android:fontFamily="@font/pretendard_medium"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="♡ 0"
                        android:textAllCaps="false"
                        android:textColor="@color/mumugray_400"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_bookmark"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_community_action"
                        android:fontFamily="@font/pretendard_medium"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="북마크 0"
                        android:textAllCaps="false"
                        android:textColor="@color/mumugray_400"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_semibold"
                android:text="댓글"
                android:textColor="@color/mumugray_400"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pretendard_regular"
                android:text="따뜻한 말을 나눠주세요."
                android:textColor="@color/mumugray_200"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_comment"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_community_input"
                    android:fontFamily="@font/pretendard_regular"
                    android:hint="댓글을 입력해 주세요"
                    android:maxLines="1"
                    android:paddingHorizontal="13dp"
                    android:textColor="@color/mumugray_400"
                    android:textColorHint="@color/mumugray_200"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_comment"
                    android:layout_width="68dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_analysis_primary"
                    android:fontFamily="@font/pretendard_medium"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="등록"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_comment_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="아직 댓글이 없어요. 첫 댓글을 남겨보세요!"
                android:textColor="@color/mumugray_200"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_community_card"
                android:clipToPadding="false"
                android:paddingVertical="4dp"
                tools:listitem="@layout/item_community_comment" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_detail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/mumu_300"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:textColor="@color/mumugray_350"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_retry"
            android:layout_width="128dp"
            android:layout_height="43dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_analysis_primary"
            android:fontFamily="@font/pretendard_medium"
            android:text="다시 시도"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

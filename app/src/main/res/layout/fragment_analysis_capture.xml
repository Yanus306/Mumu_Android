<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <FrameLayout
        android:id="@+id/layout_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="19dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_analysis_video"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@id/layout_capture_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <VideoView
            android:id="@+id/video_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_capture_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:padding="32dp"
            android:text="촬영 버튼을 누르면 카메라가 열립니다.\n반려동물의 전신이 보이도록 촬영해 주세요."
            android:textAlignment="center"
            android:textColor="@color/mumugray_350"
            android:textSize="@dimen/body_4" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_capture_actions"
        android:layout_width="288dp"
        android:layout_height="64dp"
        android:layout_marginBottom="47dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_retake"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_analysis_circle_outline"
            android:fontFamily="@font/pretendard_medium"
            android:text="재촬영"
            android:textAllCaps="false"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_5"
            android:visibility="invisible"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_record"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_analysis_circle_primary"
            android:fontFamily="@font/pretendard_semibold"
            android:text="촬영"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/body_4"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_analyze_video"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_analysis_item"
            android:fontFamily="@font/pretendard_medium"
            android:text="분석"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/body_5"
            android:visibility="invisible"
            app:backgroundTint="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

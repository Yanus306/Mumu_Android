<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_profile"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="30dp"
        android:clipToOutline="true"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/dog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeColor="@color/mumumint_300"
        app:strokeWidth="2dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_pet_profile"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginHorizontal="100dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pill_mint"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_profile">

        <ImageView
            android:id="@+id/iv_gender"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_man"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_pet_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="멍뭉이"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_pet_age"
            app:layout_constraintStart_toEndOf="@id/iv_gender"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_pet_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="n살"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layout_menu_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_pet_profile">

        <LinearLayout
            android:id="@+id/btn_history"
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                app:tint="@color/mumumint_300" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="내역"
                android:textColor="@color/mumumint_300"
                android:textSize="@dimen/body_5" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_diary"
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_diary"
                app:tint="@color/mumumint_300" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="일기"
                android:textColor="@color/mumumint_300"
                android:textSize="@dimen/body_5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_foot"
                app:tint="@color/mumugray_150" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="준비중"
                android:textColor="@color/mumugray_150"
                android:textSize="@dimen/body_5" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_foot"
                app:tint="@color/mumugray_150" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="준비중"
                android:textColor="@color/mumugray_150"
                android:textSize="@dimen/body_5" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_post_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="인기 게시글"
        android:textColor="@color/mumugray_400"
        android:textSize="@dimen/body_5"
        app:layout_constraintStart_toStartOf="@id/layout_menu_buttons"
        app:layout_constraintTop_toBottomOf="@id/layout_menu_buttons" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_good_post1"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_post_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_post_title">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_post_profile1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:clipToOutline="true"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dog"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/mumumint_300"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/tv_name1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="NickName"
            android:textColor="@color/mumugray_200"
            android:textSize="@dimen/body_6"
            app:layout_constraintStart_toEndOf="@id/iv_post_profile1"
            app:layout_constraintTop_toTopOf="@id/iv_post_profile1" />

        <TextView
            android:id="@+id/tv_post_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="게시글 제목"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_5"
            app:layout_constraintStart_toStartOf="@id/tv_name1"
            app:layout_constraintTop_toBottomOf="@id/tv_name1" />

        <TextView
            android:id="@+id/tv_post_body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="게시글 내용 내용 어떤걸 적어야할지.."
            android:textColor="@color/mumugray_200"
            android:textSize="@dimen/body_6"
            app:layout_constraintStart_toStartOf="@id/tv_name1"
            app:layout_constraintTop_toBottomOf="@id/tv_post_title1" />

        <ImageView
            android:id="@+id/iv_heart1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_empty_heart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_good_post2"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_post_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_good_post1">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_post_profile2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:clipToOutline="true"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dog"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/mumumint_300"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/tv_name2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="NickName"
            android:textColor="@color/mumugray_200"
            android:textSize="@dimen/body_6"
            app:layout_constraintStart_toEndOf="@id/iv_post_profile2"
            app:layout_constraintTop_toTopOf="@id/iv_post_profile2" />

        <TextView
            android:id="@+id/tv_post_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="게시글 제목"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_5"
            app:layout_constraintStart_toStartOf="@id/tv_name2"
            app:layout_constraintTop_toBottomOf="@id/tv_name2" />

        <TextView
            android:id="@+id/tv_post_body2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="게시글 내용 내용 어떤걸 적어야할지.."
            android:textColor="@color/mumugray_200"
            android:textSize="@dimen/body_6"
            app:layout_constraintStart_toStartOf="@id/tv_name2"
            app:layout_constraintTop_toBottomOf="@id/tv_post_title2" />

        <ImageView
            android:id="@+id/iv_heart2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_heart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_good_post3"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_post_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_good_post2">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_post_profile3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:clipToOutline="true"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dog"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/mumumint_300"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/tv_name3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="NickName"
            android:textColor="@color/mumugray_200"
            android:textSize="@dimen/body_6"
            app:layout_constraintStart_toEndOf="@id/iv_post_profile3"
            app:layout_constraintTop_toTopOf="@id/iv_post_profile3" />

        <TextView
            android:id="@+id/tv_post_title3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="게시글 제목"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_5"
            app:layout_constraintStart_toStartOf="@id/tv_name3"
            app:layout_constraintTop_toBottomOf="@id/tv_name3" />

        <TextView
            android:id="@+id/tv_post_body3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="게시글 내용 내용 어떤걸 적어야할지.."
            android:textColor="@color/mumugray_200"
            android:textSize="@dimen/body_6"
            app:layout_constraintStart_toStartOf="@id/tv_name3"
            app:layout_constraintTop_toBottomOf="@id/tv_post_title3" />

        <ImageView
            android:id="@+id/iv_heart3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_heart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_analyze"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/btn_selector"
        android:fontFamily="@font/pretendard_regular"
        android:text="분석하기"
        android:textColor="@color/white"
        android:textSize="@dimen/body_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
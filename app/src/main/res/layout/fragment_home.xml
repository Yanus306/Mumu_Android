<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_pet_profile"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="16sp"
        android:background="@drawable/bg_post_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_post_profile"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="11dp"
            android:clipToOutline="true"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dog"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/mumu_300"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/tv_subTitle_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="33dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="멍뭉이"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4"
            app:layout_constraintBottom_toBottomOf="@id/iv_post_profile"
            app:layout_constraintStart_toEndOf="@id/iv_post_profile"
            app:layout_constraintTop_toTopOf="@id/iv_post_profile" />

        <ImageView
            android:id="@+id/iv_dog_foot"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/dog_foot"
            app:layout_constraintBottom_toBottomOf="@id/tv_repeat"
            app:layout_constraintEnd_toEndOf="@id/tv_repeat"
            app:layout_constraintStart_toStartOf="@id/tv_repeat"
            app:layout_constraintTop_toTopOf="@id/tv_repeat" />

        <TextView
            android:id="@+id/tv_repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="7"
            android:textColor="@color/white"
            android:textSize="@dimen/body_3"
            app:layout_constraintBottom_toBottomOf="@id/tv_subTitle_name"
            app:layout_constraintStart_toEndOf="@id/tv_subTitle_name"
            app:layout_constraintTop_toTopOf="@id/tv_subTitle_name" />

        <TextView
            android:id="@+id/tv_subTitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="일째 기록중"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4"
            app:layout_constraintBottom_toBottomOf="@id/tv_repeat"
            app:layout_constraintStart_toEndOf="@id/iv_dog_foot"
            app:layout_constraintTop_toTopOf="@id/tv_repeat" />

        <TextView
            android:id="@+id/tv_pet_name"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_yellow"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:text="멍뭉이"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4"
            app:layout_constraintStart_toStartOf="@id/iv_post_profile"
            app:layout_constraintTop_toBottomOf="@id/iv_post_profile" />

        <TextView
            android:id="@+id/tv_pet_age"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_pill_yellow"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:text="n살"
            android:textColor="@color/mumugray_400"
            android:textSize="@dimen/body_4"
            app:layout_constraintEnd_toStartOf="@id/layout_heart"
            app:layout_constraintStart_toEndOf="@id/tv_pet_name"
            app:layout_constraintTop_toTopOf="@id/tv_pet_name" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_heart"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_pill_yellow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_pet_name">

            <ImageView
                android:id="@+id/iv_heart"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_heart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_heart"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:text="280"
                android:textColor="@color/mumugray_400"
                android:textSize="@dimen/body_4"
                app:layout_constraintBottom_toBottomOf="@id/iv_heart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_heart"
                app:layout_constraintTop_toTopOf="@id/iv_heart" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_analyze"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_analyze"
        android:fontFamily="@font/pretendard_regular"
        android:text="분석하기"
        android:textColor="@color/mumugray_400"
        android:textSize="@dimen/body_4"
        app:layout_constraintEnd_toStartOf="@id/btn_write"
        app:layout_constraintStart_toStartOf="@id/layout_pet_profile"
        app:layout_constraintTop_toBottomOf="@id/layout_pet_profile" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_write"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_write"
        android:fontFamily="@font/pretendard_regular"
        android:text="글 쓰기"
        android:textColor="@color/mumugray_400"
        android:textSize="@dimen/body_4"
        app:layout_constraintEnd_toEndOf="@id/layout_pet_profile"
        app:layout_constraintStart_toEndOf="@id/btn_analyze"
        app:layout_constraintTop_toTopOf="@id/btn_analyze" />

    <LinearLayout
        android:id="@+id/layout_menu_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_analyze">

        <LinearLayout
            android:id="@+id/btn_peed"
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_diary"
                app:tint="@color/mumu_300" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="게시글"
                android:textColor="@color/mumu_300"
                android:textSize="@dimen/body_5" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_history"
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                app:tint="@color/mumugray_150" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="내역"
                android:textColor="@color/mumugray_150"
                android:textSize="@dimen/body_5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_foot"
                app:tint="@color/mumugray_150" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="준비중"
                android:textColor="@color/mumugray_150"
                android:textSize="@dimen/body_5" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_foot"
                app:tint="@color/mumugray_150" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="준비중"
                android:textColor="@color/mumugray_150"
                android:textSize="@dimen/body_5" />

        </LinearLayout>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/layout_pet_profile"
        app:layout_constraintStart_toStartOf="@id/layout_pet_profile"
        app:layout_constraintTop_toBottomOf="@id/layout_menu_buttons" />

</androidx.constraintlayout.widget.ConstraintLayout>
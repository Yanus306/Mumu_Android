<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/hospitalFragment"
        android:name="kr.ac.anu.mumu.presentation.main.HospitalFragment"
        tools:layout="@layout/fragment_hospital" />

    <fragment
        android:id="@+id/diaryFragment"
        android:name="kr.ac.anu.mumu.presentation.main.DiaryFragment"
        tools:layout="@layout/fragment_diary" />

    <fragment
        android:id="@+id/diaryEditorFragment"
        android:name="kr.ac.anu.mumu.presentation.main.DiaryEditorFragment"
        tools:layout="@layout/dialog_diary_form">
        <argument android:name="diaryId" android:defaultValue="-1L" app:argType="long" />
        <argument android:name="diaryDate" android:defaultValue="" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/diaryDetailPageFragment"
        android:name="kr.ac.anu.mumu.presentation.main.DiaryDetailPageFragment"
        tools:layout="@layout/dialog_diary_detail">
        <argument android:name="diaryId" app:argType="long" />
    </fragment>


    <fragment
        android:id="@+id/homeFragment"
        android:name="kr.ac.anu.mumu.presentation.main.HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_analysisStartFragment"
            app:destination="@id/analysisStartFragment" />
        <action
            android:id="@+id/action_homeFragment_to_communityWriteFragment"
            app:destination="@id/communityWriteFragment" />
    </fragment>

    <fragment
        android:id="@+id/myFragment"
        android:name="kr.ac.anu.mumu.presentation.main.MyFragment"
        tools:layout="@layout/fragment_my" />

    <fragment
        android:id="@+id/petFormFragment"
        android:name="kr.ac.anu.mumu.presentation.main.PetFormFragment"
        tools:layout="@layout/dialog_pet_form">
        <argument android:name="petId" android:defaultValue="-1L" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/petManageFragment"
        android:name="kr.ac.anu.mumu.presentation.main.PetManageFragment"
        tools:layout="@layout/fragment_pet_manage" />

    <fragment
        android:id="@+id/communityFragment"
        android:name="kr.ac.anu.mumu.presentation.main.CommunityFragment"
        tools:layout="@layout/fragment_community" />

    <fragment
        android:id="@+id/communityPostListFragment"
        android:name="kr.ac.anu.mumu.presentation.main.CommunityPostListFragment"
        tools:layout="@layout/fragment_community_post_list">
        <argument
            android:name="query"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/analysisStartFragment"
        android:name="kr.ac.anu.mumu.presentation.analysis.AnalysisStartFragment"
        tools:layout="@layout/fragment_analysis_start">
        <action
            android:id="@+id/action_analysisStartFragment_to_analysisCaptureFragment"
            app:destination="@id/analysisCaptureFragment" />
        <action
            android:id="@+id/action_analysisStartFragment_to_analysisUploadFragment"
            app:destination="@id/analysisUploadFragment" />
    </fragment>

    <fragment
        android:id="@+id/analysisCaptureFragment"
        android:name="kr.ac.anu.mumu.presentation.analysis.AnalysisCaptureFragment"
        tools:layout="@layout/fragment_analysis_capture">
        <action
            android:id="@+id/action_analysisCaptureFragment_to_analysisLoadingFragment"
            app:destination="@id/analysisLoadingFragment" />
    </fragment>

    <fragment
        android:id="@+id/analysisUploadFragment"
        android:name="kr.ac.anu.mumu.presentation.analysis.AnalysisUploadFragment"
        tools:layout="@layout/fragment_analysis_upload">
        <action
            android:id="@+id/action_analysisUploadFragment_to_analysisLoadingFragment"
            app:destination="@id/analysisLoadingFragment" />
    </fragment>

    <fragment
        android:id="@+id/analysisLoadingFragment"
        android:name="kr.ac.anu.mumu.presentation.analysis.AnalysisLoadingFragment"
        tools:layout="@layout/fragment_analysis_loading">
        <action
            android:id="@+id/action_analysisLoadingFragment_to_analysisResultFragment"
            app:destination="@id/analysisResultFragment"
            app:popUpTo="@id/analysisLoadingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/analysisResultFragment"
        android:name="kr.ac.anu.mumu.presentation.analysis.AnalysisResultFragment"
        tools:layout="@layout/fragment_analysis_result" />

    <fragment
        android:id="@+id/analysisHistoryDetailFragment"
        android:name="kr.ac.anu.mumu.presentation.main.HistoryDetailFragment"
        tools:layout="@layout/fragment_history_detail">
        <argument
            android:name="analysisId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/communityDetailFragment"
        android:name="kr.ac.anu.mumu.presentation.main.CommunityDetailFragment"
        tools:layout="@layout/fragment_community_detail">
        <argument
            android:name="postId"
            app:argType="long" />
        <action
            android:id="@+id/action_communityDetailFragment_to_communityWriteFragment"
            app:destination="@id/communityWriteFragment" />
    </fragment>

    <fragment
        android:id="@+id/communityWriteFragment"
        android:name="kr.ac.anu.mumu.presentation.main.CommunityWriteFragment"
        tools:layout="@layout/fragment_community_write">
        <argument
            android:name="postId"
            android:defaultValue="-1L"
            app:argType="long" />
        <action
            android:id="@+id/action_communityWriteFragment_to_communityDetailFragment"
            app:destination="@id/communityDetailFragment"
            app:popUpTo="@id/communityWriteFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
